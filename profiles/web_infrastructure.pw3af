[profile]
description = Use all the available techniques in w3af to fingerprint the remote Web infrastructure.
name = web_infrastructure

[infrastructure.shared_hosting]
result_limit = 300

[misc-settings]
form_fuzzing_mode = tmb
fuzzed_files_extension = gif
fuzzable_headers = 
fuzz_form_files = True
fuzz_url_filenames = False
max_discovery_time = 120
blacklist_http_request = 
blacklist_audit = 
fuzz_url_parts = False
stop_on_first_exception = False
interface = ppp0
local_ip_address = 10.5.6.18
msf_location = /opt/metasploit3/bin/
fuzz_cookies = False
max_scan_time = 240
path_max_variants = 50
params_max_variants = 15
max_equal_form_variants = 5
form_id_list = []
form_id_action = exclude
vulndb_language = en

[infrastructure.fingerprint_os]

[infrastructure.hmap]
gen_fingerprint = False
threads = 4

[infrastructure.afd]

[http-settings]
proxy_port = 8080
url_parameter = 
never_404 = 
headers_file = 
proxy_address = 
basic_auth_domain = 
always_404 = 
max_http_retries = 2
ntlm_auth_user = 
ntlm_auth_passwd = 
ignore_session_cookies = False
timeout = 0
user_agent = w3af.org
basic_auth_user = 
basic_auth_passwd = 
string_match_404 = 
cookie_jar_file = 
ntlm_auth_domain = 
ntlm_auth_url = 
rand_user_agent = False
max_file_size = 400000
max_requests_per_second = 0

[output.console]
verbose = False
use_colors = True

[infrastructure.fingerprint_waf]

[infrastructure.detect_transparent_proxy]

[infrastructure.find_vhosts]

[infrastructure.detect_reverse_proxy]

[infrastructure.zone_h]

[infrastructure.finger_google]
result_limit = 300
fast_search = False

[infrastructure.favicon_identification]

[infrastructure.server_header]

[infrastructure.dns_wildcard]

[infrastructure.server_status]

[infrastructure.http_vs_https_dist]
httpPort = 80
httpsPort = 443

[infrastructure.find_jboss]

[infrastructure.finger_bing]
result_limit = 300

[infrastructure.domain_dot]

[infrastructure.finger_pks]

[infrastructure.allowed_methods]
run_once = True
dav_only = True

[infrastructure.xssed_dot_com]

