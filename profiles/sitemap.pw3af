[profile]
description = Use different online techniques to create a fast sitemap of the target web application. This plugin will only work if you've got Internet access and the target web application is being spidered by Yahoo!
name = sitemap

[crawl.sitemap_xml]

[misc-settings]
fuzzed_files_extension = gif
fuzzable_headers = 
fuzz_form_files = True
fuzz_url_filenames = False
max_discovery_time = 120
form_fuzzing_mode = tmb
blacklist_http_request = 
blacklist_audit = 
fuzz_url_parts = False
stop_on_first_exception = False
interface = ppp0
local_ip_address = 10.5.6.18
msf_location = /opt/metasploit3/bin/
fuzz_cookies = False
max_scan_time = 240
path_max_variants = 50
params_max_variants = 15
max_equal_form_variants = 5
form_id_list = []
form_id_action = exclude
vulndb_language = en

[crawl.robots_txt]

[http-settings]
proxy_port = 8080
url_parameter = 
never_404 = 
headers_file = 
proxy_address = 
basic_auth_domain = 
always_404 = 
max_http_retries = 2
ntlm_auth_user = 
ntlm_auth_passwd = 
ignore_session_cookies = False
timeout = 0
user_agent = w3af.org
basic_auth_user = 
basic_auth_passwd = 
string_match_404 = 
cookie_jar_file = 
ntlm_auth_domain = 
ntlm_auth_url = 
rand_user_agent = False
max_file_size = 400000
max_requests_per_second = 0

[output.console]
verbose = False
use_colors = True

[crawl.bing_spider]
result_limit = 300

[crawl.archive_dot_org]
max_depth = 3

[crawl.web_spider]
only_forward = False
follow_regex = .*
ignore_regex = 
ignore_extensions = 

[crawl.urllist_txt]

[crawl.google_spider]
result_limit = 300

